# Anthropic API key for the AI tutor and question generator.
# Without it the app still runs: /api/tutor returns the question's real mark
# scheme and /api/generate uses the deterministic offline generators.
#
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: OAuth token instead of an API key (see the Anthropic SDK docs).
# ANTHROPIC_AUTH_TOKEN=
