# ---------------------------------------------------------------------------
# Model provider. Set ONE of these; the app picks whichever is present.
# Without either, the app still runs: /api/chat answers from the boundary
# tables and curriculum, /api/tutor returns the question's real mark scheme,
# and /api/generate uses the deterministic offline generators.
# ---------------------------------------------------------------------------

# Option A — FreeTheAI, an OpenAI-compatible endpoint fronting Gemini.
# This is what the deployed site runs on.
FREETHEAI_API_KEY=
# GEMINI_API_KEY is accepted as an alias, for projects where the same key is
# already deployed under that name. FREETHEAI_API_KEY wins if both are set.
# GEMINI_API_KEY=
# Optional overrides:
# FREETHEAI_BASE_URL=https://api.freetheai.xyz/v1
# FREETHEAI_MODEL=bbl/gemini-3.5-flash

# Option B — Anthropic (uses claude-opus-5 with adaptive thinking).
# Takes precedence over FreeTheAI when both are set.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Local:      copy this file to .env.local and fill in a key there.
#             .env.local is gitignored — never commit a real key.
# Vercel:     Project → Settings → Environment Variables. Add the key for
#             Production, Preview and Development, then redeploy. Never put a
#             key in NEXT_PUBLIC_* — it would ship to the browser.
# ---------------------------------------------------------------------------
