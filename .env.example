# ---------------------------------------------------------------- AI tutor
# Optional. Without a key the tutor falls back to the offline explanations in
# lib/offline-variants.ts and the app still works end to end.
#
# Set ONE of these. Precedence: Anthropic, then Groq, then FreeTheAI.
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# FREETHEAI_API_KEY=
# GEMINI_API_KEY=          # alias for FREETHEAI_API_KEY
#
# Overrides, if a model or endpoint moves:
# GROQ_MODEL=              # default openai/gpt-oss-120b
# GROQ_BASE_URL=           # default https://api.groq.com/openai/v1
# GROQ_REASONING_EFFORT=   # default low — see README, an unbounded budget
#                          # lets reasoning crowd out the answer entirely

# --------------------------------------------------------- Accounts (Firebase)
# Optional. Leave these unset and the app keeps every student's progress in
# localStorage exactly as before — the sign-in button does not render at all.
# Set all five to turn on Google sign-in and cross-device sync.
#
# These values are NOT secrets: Firebase web config is public by design, and
# access is enforced by firestore.rules. Copy them from
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
