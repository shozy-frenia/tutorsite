# ---------------------------------------------------------------------------
# Model provider. Set ONE of these; the app picks whichever is present.
# Without either, the app still runs: /api/tutor returns the question's real
# mark scheme and /api/generate uses the deterministic offline generators.
# ---------------------------------------------------------------------------

# Option A — Anthropic (uses claude-opus-5 with adaptive thinking).
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B — FreeTheAI, an OpenAI-compatible endpoint fronting Gemini.
FREETHEAI_API_KEY=
# Optional overrides:
# FREETHEAI_BASE_URL=https://api.freetheai.xyz/v1
# FREETHEAI_MODEL=bbl/gemini-3.5-flash

# Copy this file to .env.local and fill in a key there.
# .env.local is gitignored — never commit a real key.
