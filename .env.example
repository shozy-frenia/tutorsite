# ---------------------------------------------------------------------------
# Model provider. Set ONE of these; the app picks whichever is present.
# Without any, the app still runs: /api/chat answers from the boundary
# tables and curriculum, /api/tutor returns the question's real mark scheme,
# and /api/generate uses the deterministic offline generators.
#
# Precedence: Anthropic, then Groq, then FreeTheAI.
# ---------------------------------------------------------------------------

# Option A — Groq, OpenAI-compatible, running openai/gpt-oss-120b. This is
# what the deployed site runs on.
GROQ_API_KEY=
# Overrides, if the model or endpoint moves:
# GROQ_MODEL=              # default openai/gpt-oss-120b
# GROQ_BASE_URL=           # default https://api.groq.com/openai/v1
# GROQ_REASONING_EFFORT=   # default low. gpt-oss reasons before it answers and
#                          # max_tokens caps reasoning and answer together, so
#                          # an unbounded budget lets the thinking crowd the
#                          # answer out entirely. See the README.

# Option B — FreeTheAI, an OpenAI-compatible endpoint fronting Gemini.
FREETHEAI_API_KEY=
# GEMINI_API_KEY is accepted as an alias.
# GEMINI_API_KEY=

# Option C — Anthropic. Takes precedence over the other two when set.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — accounts and progress sync.
#
# Both of these are safe to expose to the browser: the anon key only ever gets
# you the rows RLS lets you have, and every table in supabase/schema.sql is
# owner-scoped. Never add the SERVICE_ROLE key here or to any NEXT_PUBLIC_*
# name — it bypasses RLS entirely.
#
# Leave them blank and the app runs exactly as before: guest mode, progress in
# localStorage, no sign-in UI anywhere.
#
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Public origin, for canonical and hreflang URLs.
#
# Must be the address the site actually serves on, not the one that redirects
# to it: talap.online 308s to www.talap.online, so the canonical is the www
# form. Defaults to https://www.talap.online when unset.
#
# The same origin has to be allowlisted in Supabase → Authentication → URL
# Configuration, because the sign-in dialog builds its redirect from
# window.location.origin. An address missing from that list is refused and the
# magic link silently drops the student on the Site URL instead.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Local:      copy this file to .env.local and fill in keys there.
#             .env.local is gitignored — never commit a real key.
# Vercel:     Project → Settings → Environment Variables. Add for Production,
#             Preview and Development, then redeploy.
# ---------------------------------------------------------------------------
